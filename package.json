{
  "name": "hands",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
   "sass": "sass src/scss/app.scss dist/css/app.css --style=expanded --no-error-css --quiet-deps",
    "sass:watch": "sass src/scss/app.scss dist/css/app.css --style=expanded --watch --no-error-css --quiet-deps",
    "serve": "browser-sync start --server --startPath html/index.html --files \"dist/css/*.css, html/**/*.html, assets/**/*\" --port 5173",
    "dev": "run-p sass:watch serve",
    "build": "npm run sass",
    "clean": "rm -rf dist/css/*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.93.2"
  }
}
